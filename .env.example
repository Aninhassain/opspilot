# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/opspilot?retryWrites=true&w=majority

# Clerk Configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/signup

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specify a custom Gemini model (e.g., gemini-1.5-pro, gemini-1.5-flash)
# If not set, the app will try multiple models automatically
# Check available models at: https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-2.5-flash

# Application URL (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

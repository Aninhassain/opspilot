# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/opspilot?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specify a custom Gemini model (e.g., gemini-1.5-pro, gemini-1.5-flash)
# If not set, the app will try multiple models automatically
# Check available models at: https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-2.5-flash

# Application URL (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
